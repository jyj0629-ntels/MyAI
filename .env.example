# --------------------------------------------------
# MyAI Environment Template
# --------------------------------------------------

# Public provider defaults
PRIMARY_PROVIDER=gemini
PUBLIC_PROVIDERS=gemini,groq,mistral

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Local LLM / Brain (must always use Ollama)
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_BRAIN_DEFAULT_PROVIDER=ollama
LOCAL_CONSENSUS_PROVIDER=ollama
LOCAL_LLM_DEEP_ANALYSIS_ENABLED=true
LOCAL_LLM_FAST_PATH_ENABLED=true
LOCAL_LLM_FAST_PATH_MAX_CHARS=120
OLLAMA_HOST=http://ollama:11434
OLLAMA_GENERATE_URL=http://ollama:11434/api/generate
OLLAMA_TIMEOUT=600

# Optional / shared settings
CONSENSUS_THRESHOLD=80
MIN_CONSENSUS_RESPONSES=2
ENABLE_LOCAL_CONSENSUS=true
ENABLE_LOCAL_LLM_JUDGE=false
ALLOW_SINGLE_PROVIDER=true
ENABLE_CONFLICT_MODE=true
FALLBACK_PROVIDERS=groq,deepseek
MULTI_PROVIDER_EXCLUDE=ollama

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=myai
POSTGRES_USER=myai
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+psycopg://myai:your_db_password_here@postgres:5432/myai
